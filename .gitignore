/android/.idea
/.dart_tool
.DS_Store
/.idea

# Build output. Anchored on purpose: config/build/ holds tracked build configuration.
# The Gradle build directory is redirected to /build (android/build.gradle.kts).
/build/
/android/app/build/

# Written by `flutter pub get`
.flutter-plugins-dependencies

# Local Claude Code settings
.claude/settings.local.json

# Local credentials and signing material. The Android patterns (key.properties, *.jks, *.keystore)
# live in android/.gitignore and are pinned by tool/test_android_release.sh. Templates stay trackable.
*.p12
*.p8
*.pem
*.mobileprovision
.env
.env.*
!.env.example
!.env.*.example
google-services.json
GoogleService-Info.plist

# Flutter generated state for the local dlc_wallet plugin
/flutter_plugin/flutter_plugin/.dart_tool/

# dlc_wallet is a reusable Flutter plugin; resolve its dependencies locally
/flutter_plugin/flutter_plugin/pubspec.lock
